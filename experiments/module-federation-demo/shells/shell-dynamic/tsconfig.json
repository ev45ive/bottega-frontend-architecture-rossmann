{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "remoteJs/*": ["./@mf-types/remoteJs/*"],
      "remoteReact/*": ["./@mf-types/remoteReact/*"]
    }
  },
  "include": ["src", "webpack.config.ts", "@mf-types"]
}
